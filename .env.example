# Agent answering transcripts and screenshots (independent of STT_PROVIDER).
# openai (default) or cursor
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4.1-mini

# Required for either agent provider. Use a key from the selected service.
# OpenAI: https://platform.openai.com/api-keys
# Cursor: https://cursor.com/dashboard/integrations
AGENT_API_KEY=sk-...

# For AGENT_PROVIDER=cursor, set AGENT_MODEL=composer-2.5 or remove it.

# Transcription. Calls are always English (language=en, no autodetect).
# macos = SpeechAnalyzer on-device (macOS 26+, no extra key)
# openai = gpt-4o-mini-transcribe
# groq = whisper-large-v3-turbo
# auto = Groq if GROQ_API_KEY is set, else OpenAI, else macos
STT_PROVIDER=macos

# Optional; OpenAI transcription uses its own credential independently of the agent.
# Set this only for STT_PROVIDER=openai or auto with OpenAI.
# OPENAI_API_KEY=sk-...

# Optional; only if STT_PROVIDER=groq or auto with Groq
GROQ_API_KEY=gsk_...

# Electron accelerators. Option on Mac = Alt
HOTKEY=Alt+Space
CHECKPOINT_HOTKEY=Alt+1
SUMMARY_HOTKEY=Alt+2
BRIEFING_HOTKEY=Alt+3

# Screenshot region → agent. Option+Shift+Space on Mac = Alt+Shift+Space
SCREENSHOT_HOTKEY=Alt+Shift+Space
