# Agent answering transcripts and screenshots (independent of STT_PROVIDER).
# openai (default) or cursor
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4.1-mini

# Required for either agent provider. Use a key from the selected service.
# OpenAI: https://platform.openai.com/api-keys
# Cursor: https://cursor.com/dashboard/integrations
AGENT_API_KEY=sk-...

# For AGENT_PROVIDER=cursor, set AGENT_MODEL=composer-2.5 or remove it.

# Transcription. Calls are always English (language=en, no autodetect).
# macos = SpeechAnalyzer on-device (macOS 26+, no extra key)
# openai = gpt-4o-mini-transcribe
# groq = whisper-large-v3-turbo
# auto = OpenAI if STT_PROVIDER_API_KEY is set, else macos
STT_PROVIDER=macos

# Required for cloud STT; independent of AGENT_API_KEY.
# Use an OpenAI key for STT_PROVIDER=openai, or a Groq key for STT_PROVIDER=groq.
# For auto with a cloud key, use an OpenAI key. macos needs no key.
STT_PROVIDER_API_KEY=sk-...

# Electron accelerators. Option on Mac = Alt
HOTKEY=Alt+Space
CHECKPOINT_HOTKEY=Alt+1
SUMMARY_HOTKEY=Alt+2
BRIEFING_HOTKEY=Alt+3

# Screenshot region → agent. Option+Shift+Space on Mac = Alt+Shift+Space
SCREENSHOT_HOTKEY=Alt+Shift+Space

# Toggle stealth mode / restore the app (works even while an agent is busy).
STEALTH_HOTKEY=Alt+Shift+S

# Keyboard-only overlay controls, including while the agent is working.
OVERLAY_TOGGLE_HOTKEY=Alt+Shift+B
OVERLAY_LEFT_HOTKEY=Alt+Shift+Left
OVERLAY_RIGHT_HOTKEY=Alt+Shift+Right
OVERLAY_UP_HOTKEY=Alt+Shift+Up
OVERLAY_DOWN_HOTKEY=Alt+Shift+Down
OVERLAY_SCROLL_UP_HOTKEY=Alt+Control+Up
OVERLAY_SCROLL_DOWN_HOTKEY=Alt+Control+Down
OVERLAY_OPACITY_DOWN_HOTKEY=Alt+Shift+-
OVERLAY_OPACITY_UP_HOTKEY=Alt+Shift+=
OVERLAY_RESET_HOTKEY=Alt+Shift+0

# Default overlay opacity, as a whole percentage from 30 to 100.
OVERLAY_OPACITY=100
